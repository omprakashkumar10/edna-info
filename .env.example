# GEMINI_API_KEY: Required for server-side Gemini API calls (AI-assisted ecological explanations).
# AI Studio injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# SUPABASE_URL: Your Supabase project URL (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL=

# SUPABASE_SERVICE_ROLE_KEY: Server-only Supabase service role key (never expose to browser).
SUPABASE_SERVICE_ROLE_KEY=

# SUPABASE_STORAGE_BUCKET: Supabase Storage bucket for raw eDNA datasets (default: edna-datasets).
SUPABASE_STORAGE_BUCKET=edna-datasets

# ADMIN_EMAILS: Comma-separated allowlist of verified administrator emails.
ADMIN_EMAILS=

# ADMIN_PASSCODE: Optional server-side passcode for Control Center admin verification.
ADMIN_PASSCODE=

# NCBI_API_KEY: Optional NCBI E-utilities / BLAST API key for higher bioinformatics query throughput.
NCBI_API_KEY=
